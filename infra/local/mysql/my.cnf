[mysqld]
# Local dev settings. Cloud values are set per instance size in Terraform.
innodb_buffer_pool_size = 1G
innodb_log_file_size = 512M
innodb_flush_log_at_trx_commit = 1
sync_binlog = 1
max_connections = 1000
skip-name-resolve

# Replication (S3). Replicas override server_id on the command line.
server_id = 1
gtid_mode = ON
enforce_gtid_consistency = ON
